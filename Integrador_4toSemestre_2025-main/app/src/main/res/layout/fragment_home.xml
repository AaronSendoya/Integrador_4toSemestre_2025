<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: título + avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bottom_border">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_panel_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/gray_800" />

            <ImageView
                android:id="@+id/iv_home_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user_placeholder"
                android:contentDescription="@string/home_avatar_cd"
                android:background="@drawable/circle_border_red"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Tarjeta principal de alerta -->
        <LinearLayout
            android:id="@+id/ll_main_alert_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/rounded_card_green"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_alert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_alert_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/tv_alert_recommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_alert_recommendation"
                android:textSize="14sp"
                android:textColor="@color/white_70"
                tools:ignore="TextContrastCheck" />

            <!-- Link tipo botón: Ver en mapa -->
            <TextView
                android:id="@+id/btn_view_on_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_btn_view_on_map"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:minHeight="48dp"
                tools:ignore="TextContrastCheck,TouchTargetSizeCheck,KeyboardInaccessibleWidget" />
        </LinearLayout>

        <!-- Botón rojo: reportar riesgo inmediato -->
        <Button
            android:id="@+id/btn_quick_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_btn_quick_report"
            android:padding="16dp"
            android:background="@drawable/rounded_button_red"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta: datos del clima (reales) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/rounded_card_gray"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos del clima"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/gray_700"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Fila ciudad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ciudad:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

                <!-- Fila condición (icono + texto) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Condición:"
                        android:textColor="@color/gray_600" />

                    <ImageView
                        android:id="@+id/iv_sensor_condition_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Ícono clima" />

                    <TextView
                        android:id="@+id/tv_sensor_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

                <!-- Fila humedad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_sensor_label_humidity"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_sensor_value_humidity_default"
                        android:textStyle="bold"
                        android:textColor="@color/blue_600" />
                </LinearLayout>

                <!-- Fila temperatura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Temperatura:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- °C"
                        android:textStyle="bold"
                        android:textColor="@color/blue_600" />
                </LinearLayout>

                <!-- Fila probabilidad de lluvia -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Prob. lluvia:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_rain_chance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textStyle="bold"
                        android:textColor="@color/blue_600" />
                </LinearLayout>

                <!-- Fila viento (velocidad + ráfagas) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Viento:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- km/h"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

                <!-- Fila lluvia actual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lluvia ahora:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_precip_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mm"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

                <!-- Fila lluvia total pronosticada hoy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lluvia pronóstico hoy:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_precip_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mm"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

                <!-- Fila presión atmosférica -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Presión:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_pressure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- hPa"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

                <!-- Fila índice UV -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Índice UV:"
                        android:textColor="@color/gray_600" />

                    <TextView
                        android:id="@+id/tv_sensor_uv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
