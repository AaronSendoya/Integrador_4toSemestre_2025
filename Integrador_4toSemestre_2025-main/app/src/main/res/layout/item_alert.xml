<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardUseCompatPadding="true"
    card_view:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_alert_card">

        <!-- Indicador de nivel (círculo que luego puedes pintar según riesgo) -->
        <View
            android:id="@+id/view_alert_level_indicator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_alert_level_circle" />

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1">

            <!-- Fila: tipo de riesgo + nivel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_alert_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/alert_text_title"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Incendio Forestal" />

                <TextView
                    android:id="@+id/tv_alert_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_alert_level_pill"
                    android:textColor="@color/alert_level_text"
                    tools:text="ALTO" />
            </LinearLayout>

            <!-- Descripción breve -->
            <TextView
                android:id="@+id/tv_alert_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/alert_text_body"
                tools:text="Columna de humo visible, posible incendio cerca de zona residencial." />

            <!-- Fila: distancia + tiempo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_alert_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/alert_text_secondary"
                    tools:text="A 2.3 km de tu ubicación" />

                <TextView
                    android:id="@+id/tv_alert_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/alert_text_secondary"
                    tools:text="Hace 15 min" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flecha / hint de que es clickeable -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="›"
            android:textSize="18sp"
            android:textColor="@color/alert_text_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="2dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
