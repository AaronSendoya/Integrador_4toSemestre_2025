<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base oscuro (sin ActionBar) -->
    <style name="Base.Theme.RiskGuard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores para modo oscuro -->
        <item name="colorPrimary">@color/red_600</item>
        <item name="colorPrimaryVariant">@color/red_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/red_500</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Superficie oscura -->
        <item name="colorSurface">@android:color/black</item>

        <!-- Status bar y nav bar oscuros -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>

        <!-- Botones mantienen estilo RiskGuard -->
        <item name="materialButtonStyle">@style/Widget.RiskGuard.Button</item>
    </style>

    <style name="Widget.RiskGuard.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.RiskGuard.ButtonOverlay</item>
        <item name="backgroundTint">@color/red_600</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.RiskGuard.ButtonOverlay" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Igual que en el tema claro -->
    <style name="Theme.RiskGuard" parent="Base.Theme.RiskGuard" />

</resources>
